[Unit]
Description=Bridgefu all-in-one media gateway
Documentation=https://github.com/eisenzopf/bridgefu
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# The environment file must contain one immutable reference, for example:
# BRIDGEFU_IMAGE=000000000000.dkr.ecr.us-west-2.amazonaws.com/bridgefu@sha256:...
EnvironmentFile=/etc/bridgefu/image.env
ExecStartPre=/usr/bin/test -r /etc/bridgefu/bridgefu.yaml
ExecStartPre=-/usr/bin/docker rm -f bridgefu
ExecStart=/usr/bin/docker run --rm --name bridgefu \
    --network host \
    --read-only \
    --tmpfs /tmp:rw,noexec,nosuid,size=64m,mode=1777 \
    --user 65532:65532 \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --stop-timeout 30 \
    --env-file /etc/bridgefu/runtime.env \
    --mount type=bind,src=/etc/bridgefu/bridgefu.yaml,dst=/etc/bridgefu/bridgefu.yaml,readonly \
    --mount type=volume,src=bridgefu-data,dst=/var/lib/bridgefu \
    ${BRIDGEFU_IMAGE} --config /etc/bridgefu/bridgefu.yaml
ExecStop=/usr/bin/docker stop --time 30 bridgefu

Restart=on-failure
RestartSec=2
TimeoutStopSec=45
KillMode=process
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
