# syntax=docker/dockerfile:1.7
# Native-hosted cross builder for the linux/amd64 qualification tools. The
# controller replaces the multi-platform index with the exact child matching
# the Docker daemon, then Zig targets glibc 2.31 without executing x86 build
# tools under emulation.
ARG QUALIFICATION_BUILDER_IMAGE=ghcr.io/rust-cross/cargo-zigbuild@sha256:b8364c2c60cdcc9b95c402d17654bff517410926a35678bd89dd924b8158d6ae
ARG QUALIFICATION_BUILDER_AMD64_IMAGE=ghcr.io/rust-cross/cargo-zigbuild@sha256:cbcd80f28d7f316709184b6485e04c4a07305e9e105ffa87d72da5b90405a01d
ARG QUALIFICATION_BUILDER_ARM64_IMAGE=ghcr.io/rust-cross/cargo-zigbuild@sha256:cd8eb227db9f70e7c098ed1d63cdfba3b85d73b1dcbc6aa59d8f9a92ae7dd50d

FROM ${QUALIFICATION_BUILDER_IMAGE} AS qualification-builder

ARG QUALIFICATION_DEBIAN_SNAPSHOT=20260202T000000Z
ARG QUALIFICATION_RUST_TOOLCHAIN=1.95.0
ARG QUALIFICATION_TARGET=x86_64-unknown-linux-gnu.2.31

# Always compile the vendored Opus source for the x86_64 target. In particular,
# do not let a native ARM pkg-config result leak into this cross build.
ENV LIBOPUS_NO_PKG=1

RUN sed -i \
        -e "s|URIs: http://deb.debian.org/debian-security|URIs: http://snapshot.debian.org/archive/debian-security/${QUALIFICATION_DEBIAN_SNAPSHOT}|" \
        -e "s|URIs: http://deb.debian.org/debian|URIs: http://snapshot.debian.org/archive/debian/${QUALIFICATION_DEBIAN_SNAPSHOT}|" \
        /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' 'Acquire::Check-Valid-Until "false";' \
        > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils-x86-64-linux-gnu=2.44-3 \
        cmake=3.31.6-2 \
    && rm -rf /var/lib/apt/lists/* \
    && rustup toolchain install "${QUALIFICATION_RUST_TOOLCHAIN}" \
        --profile minimal \
        --target x86_64-unknown-linux-gnu

COPY . /src/bridgefu
WORKDIR /src/bridgefu

RUN cargo +"${QUALIFICATION_RUST_TOOLCHAIN}" tree --locked \
        --package bridgefu-recipe-qualification \
        --target x86_64-unknown-linux-gnu \
        --edges normal,build \
        --prefix none \
        > /tmp/qualification-cargo-tree \
    && ! grep -Eq '^aws-lc-(rs|sys) ' /tmp/qualification-cargo-tree \
    && cargo +"${QUALIFICATION_RUST_TOOLCHAIN}" zigbuild --locked --release \
        --target "${QUALIFICATION_TARGET}" \
        --package bridgefu-recipe-qualification \
        --bins \
    && install -D -m 0755 \
        target/x86_64-unknown-linux-gnu/release/recipe_sip_source \
        /out/qualification/recipe_sip_source \
    && install -D -m 0755 \
        target/x86_64-unknown-linux-gnu/release/recipe_sip_negative \
        /out/qualification/recipe_sip_negative \
    && x86_64-linux-gnu-strip /out/qualification/recipe_sip_source \
    && x86_64-linux-gnu-strip /out/qualification/recipe_sip_negative \
    && x86_64-linux-gnu-readelf -d /out/qualification/recipe_sip_source \
        > /tmp/qualification-dynamic-libraries \
    && x86_64-linux-gnu-readelf -d /out/qualification/recipe_sip_negative \
        >> /tmp/qualification-dynamic-libraries \
    && ! grep -Fq 'Shared library: [libopus.so' \
        /tmp/qualification-dynamic-libraries \
    && rm -rf target /usr/local/cargo/registry /usr/local/cargo/git

FROM scratch AS qualification-binaries

COPY --from=qualification-builder /out/qualification/ /
