# Copy to a secret-backed deployment environment. Do not commit real values.
VAPI_FIXTURE_MODE=deployment
VAPI_FIXTURE_HTTP_BIND=0.0.0.0:9443
VAPI_FIXTURE_HTTP_TLS_CERT=/run/secrets/http-cert.pem
VAPI_FIXTURE_HTTP_TLS_KEY=/run/secrets/http-key.pem
VAPI_FIXTURE_HEALTH_URL=https://127.0.0.1:9443/livez

VAPI_FIXTURE_SIP_BIND=0.0.0.0:5060
VAPI_FIXTURE_SIP_TLS_BIND=0.0.0.0:5061
VAPI_FIXTURE_SIP_ADVERTISED_ADDR=203.0.113.10:5061
VAPI_FIXTURE_PUBLIC_SIP_URI=sips:echo@observer.nonproduction.example:5061;transport=tls
VAPI_FIXTURE_SIP_TLS_CERT=/run/secrets/sip-cert.pem
VAPI_FIXTURE_SIP_TLS_KEY=/run/secrets/sip-key.pem
VAPI_FIXTURE_MEDIA_PUBLIC_IP=203.0.113.10
VAPI_FIXTURE_MEDIA_PORT_START=30000
VAPI_FIXTURE_MEDIA_PORT_END=30031

VAPI_FIXTURE_OBSERVATION_TOKEN=replace-with-distinct-random-secret-at-least-32-bytes
VAPI_FIXTURE_WEBHOOK_TOKEN=replace-with-another-random-secret-at-least-32-bytes
VAPI_FIXTURE_ALLOWED_HEADER_NAMES=x-correlation-id
VAPI_FIXTURE_MAX_ATTEMPTS=8
VAPI_FIXTURE_ATTEMPT_TTL_SECONDS=900

VAPI_FIXTURE_BRIDGEFU_API_BASE=https://bridgefu.nonproduction.example
VAPI_FIXTURE_BRIDGEFU_BEARER_TOKEN=replace-with-server-control-token-at-least-32-bytes
VAPI_FIXTURE_BRIDGEFU_ROUTE_ID=vapi-feasibility-echo
