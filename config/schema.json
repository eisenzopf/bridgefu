{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgefu.dev/schema/config-v1.json",
  "title": "Bridgefu configuration v1",
  "type": "object",
  "required": ["aws", "sip"],
  "properties": {
    "config_version": { "const": 1 },
    "aws": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "minLength": 1 },
        "instance_id": { "type": "string" },
        "contact_flow_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sip": {
      "type": "object",
      "properties": {
        "bind_ip": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "advertised_ip": { "type": "string" },
        "media_public_ip": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["all-in-one", "gateway", "worker", "moq-relay"] },
        "max_concurrent_calls": { "type": "integer", "minimum": 1 },
        "setup_timeout_secs": { "type": "integer", "minimum": 1 },
        "drain_timeout_secs": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "backend": { "enum": ["sqlite", "postgres", "postgresql", "memory"] },
        "database_url": { "type": "string", "minLength": 1 },
        "worker_id": {
          "type": "string",
          "format": "uuid",
          "not": { "const": "00000000-0000-0000-0000-000000000000" }
        },
        "allow_ephemeral_memory": { "type": "boolean" },
        "deployment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,63}$"
        },
        "worker_lease_ttl_secs": { "type": "integer", "minimum": 5, "maximum": 300 },
        "worker_renew_interval_secs": { "type": "integer", "minimum": 1 },
        "worker_capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "redis_url": {
          "type": "string",
          "pattern": "^(?:rediss?://|env:[A-Za-z_][A-Za-z0-9_]*)$"
        },
        "redis_clustered": { "type": "boolean" },
        "allow_db_only_coordination": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "backend": { "const": "memory" } },
            "required": ["backend"]
          },
          "then": {
            "required": ["allow_ephemeral_memory"],
            "properties": { "allow_ephemeral_memory": { "const": true } },
            "not": { "required": ["database_url"] }
          }
        },
        {
          "if": {
            "properties": { "backend": { "enum": ["postgres", "postgresql"] } },
            "required": ["backend"]
          },
          "then": {
            "required": ["database_url", "worker_id"],
            "anyOf": [
              {
                "required": ["redis_url", "redis_clustered"],
                "properties": { "redis_clustered": { "const": true } }
              },
              {
                "required": ["allow_db_only_coordination"],
                "properties": { "allow_db_only_coordination": { "const": true } }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "allow_db_only_coordination": { "const": true } },
            "required": ["allow_db_only_coordination"]
          },
          "then": {
            "required": ["backend"],
            "properties": { "backend": { "enum": ["postgres", "postgresql"] } }
          }
        }
      ],
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "bearer_token": { "type": "string" },
        "control_hmac_key": { "type": "string" },
        "static_tenant": { "type": "string" }
      },
      "additionalProperties": false
    },
    "broadcast": {
      "type": "object",
      "properties": {
        "default_transport": { "enum": ["moqt", "uctp-quic"] },
        "token_ttl_secs": { "type": "integer", "minimum": 1 },
        "max_active": { "type": "integer", "minimum": 1 },
        "public_endpoint": { "type": "string" },
        "token_secret": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generic_bridge": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "sip_bind": { "type": "string" },
        "webrtc_ws_bind": { "type": "string" },
        "webrtc_whip_bind": { "type": "string" },
        "bearer_token": { "type": "string" }
      },
      "additionalProperties": false
    },
    "providers": { "type": "object" },
    "context": { "type": "object" },
    "tenants": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": { "allow_db_only_coordination": { "const": true } },
            "required": ["allow_db_only_coordination"]
          }
        },
        "required": ["persistence"]
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": { "mode": { "const": "all-in-one" } }
          }
        }
      }
    }
  ]
}
