# StandardCharter half of standardcharter-managed-routes.yaml. This contains
# no secret values; inject the variable referenced by the bearer setting.
BRIDGEFU_API_BASE_URL=https://bridgefu.example.test/
BRIDGEFU_API_BEARER_TOKEN_REF=env:STANDARDCHARTER_BRIDGEFU_CONTROL_TOKEN
BRIDGEFU_ROUTE_IDS=amazon-connect,generic-sip,telnyx,generic-wss
BRIDGEFU_DEFAULT_ROUTE_ID=amazon-connect
BRIDGEFU_LEGACY_AMAZON_ROLLBACK_ENABLED=true
CONNECT_TRANSFER_SIP_URI=sips:legacy-amazon@voiceconnector.example.test;transport=tls
