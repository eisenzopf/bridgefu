# Keep build artifacts and local cruft out of the Docker build context so the
# `COPY . /src/bridgefu` layer stays small and cache-friendly. (Cargo.lock
# IS shipped — we want reproducible builds.)
target/
.git/
.claude/
.vscode/
**/node_modules/
sdk/typescript/dist/
**/.terraform/
**/*.tfstate
**/*.tfstate.*
terraform/terraform.tfvars
bridgefu.yaml
deploy/tls/
**/.env
**/.env.*
!**/.env.example
**/*.key
**/*.pem
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.jks
__pycache__/
**/__pycache__/
*.py[cod]
*.log
/etc/
deploy/*.tar.gz
