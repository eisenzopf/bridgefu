# Keep build artifacts and local cruft out of the Docker build context so the
# `COPY . /src/bridgefu` layer stays small and cache-friendly. (Cargo.lock
# IS shipped — we want reproducible builds.)
target/
.git/
.gitignore
.claude/
.vscode/
**/node_modules/
sdk/typescript/dist/
**/.terraform/
**/*.tfstate
**/*.tfstate.*
terraform/terraform.tfvars
bridgefu.yaml
deploy/tls/
**/.env
**/.env.*
!**/.env.example
**/*.key
**/*.pem
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.jks
__pycache__/
**/__pycache__/
*.py[cod]
*.log
/etc/
deploy/*.tar.gz

# Runtime images contain built-in recipe manifests but not CloudFormation or
# release-controller code. Keep infrastructure-only changes from invalidating
# the expensive Rust layer while retaining every compile-time recipe asset.
recipes/*/cloudformation/*
!recipes/vapi-amazon-connect-screen-pop/cloudformation/production-stack-policy.json
recipes/*/tests/
scripts/
BRIDGEFU-RECIPE-IMPLEMENTATION-*.md
BRIDGEFU-AWS-*.md
AWS-ADMIN-*.md
