{
  "mode": "correlation-id",
  "region": "us-west-2",
  "sip_host": "sip.bridgefu.example",
  "sip_user": "support",
  "media_public_ip": "203.0.113.10",
  "signaling_cidrs": [
    "198.51.100.0/24"
  ],
  "sip_security": "sips_srtp",
  "connect_instance_arn": "arn:aws:connect:us-west-2:123456789012:instance/11111111-1111-1111-1111-111111111111",
  "entry_contact_flow_id": "22222222-2222-2222-2222-222222222222",
  "tool_name": "transfer_to_support",
  "model_provider": "openai",
  "model": "gpt-4.1-mini",
  "voice_provider": "vapi",
  "voice_id": "Elliot",
  "system_prompt": "You are a concise support assistant. Help callers troubleshoot. Transfer when the caller requests a human.",
  "status_attribute": "handoff_status",
  "correlation": {
    "header": "X-Correlation-Id",
    "attribute": "handoff_id",
    "ttl_seconds": 3600
  },
  "fields": [
    {
      "name": "session",
      "source": "variables.customer_session",
      "header": "X-Customer-Session",
      "attribute": "customer_session",
      "description": "Customer-supplied session; never generated by the model.",
      "max_bytes": 128,
      "required": true,
      "example": "synthetic-session-001"
    },
    {
      "name": "vapi_reference",
      "source": "call.id",
      "header": "X-Vapi-Call-Id",
      "attribute": "vapi_reference",
      "description": "Vapi-generated call reference.",
      "max_bytes": 36,
      "required": true
    },
    {
      "name": "intent",
      "source": "arguments.intent",
      "header": "X-Customer-Intent",
      "attribute": "customer_intent",
      "description": "Short reason for the human handoff.",
      "max_bytes": 128,
      "required": true
    },
    {
      "name": "summary",
      "source": "arguments.summary",
      "header": "X-Conversation-Summary",
      "attribute": "conversation_summary",
      "description": "Brief factual conversation summary, including troubleshooting already attempted.",
      "max_bytes": 512,
      "required": true
    }
  ]
}
