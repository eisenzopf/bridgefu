#!/usr/bin/env bash
set -euo pipefail
umask 077

# shellcheck source=/dev/null
source /etc/bridgefu/runtime.conf
install -d -o root -g root -m 0700 /run/bridgefu

bearer="$(aws secretsmanager get-secret-value --region "$AWS_REGION" \
  --secret-id "$BRIDGEFU_API_BEARER_SECRET_ARN" --query SecretString --output text)"
hmac="$(aws secretsmanager get-secret-value --region "$AWS_REGION" \
  --secret-id "$BRIDGEFU_CONTROL_HMAC_SECRET_ARN" --query SecretString --output text)"

for value in "$bearer" "$hmac"; do
  if (( ${#value} < 32 || ${#value} > 4096 )) || [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    echo "Bridgefu runtime credential is invalid" >&2
    exit 1
  fi
done

temporary="$(mktemp /run/bridgefu/runtime.env.XXXXXX)"
trap 'rm -f "$temporary"' EXIT
printf 'BRIDGEFU_API_BEARER_TOKEN=%s\nBRIDGEFU_CONTROL_HMAC_KEY=%s\n' \
  "$bearer" "$hmac" > "$temporary"
chmod 0600 "$temporary"
mv -f "$temporary" /run/bridgefu/runtime.env
trap - EXIT
unset bearer hmac value
