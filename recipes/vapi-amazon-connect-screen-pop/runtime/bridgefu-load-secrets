#!/usr/bin/env bash
set -euo pipefail
umask 077

source /etc/bridgefu/runtime.conf
mkdir -p /run/bridgefu

bearer="$(aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$BRIDGEFU_API_BEARER_SECRET_ARN" \
  --query SecretString \
  --output text)"
hmac="$(aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$BRIDGEFU_CONTROL_HMAC_SECRET_ARN" \
  --query SecretString \
  --output text)"

if (( ${#bearer} < 32 || ${#bearer} > 4096 )) || [[ "$bearer" == *$'\n'* || "$bearer" == *$'\r'* ]]; then
  echo "Bridgefu API credential is invalid" >&2
  exit 1
fi
if (( ${#hmac} < 32 || ${#hmac} > 4096 )) || [[ "$hmac" == *$'\n'* || "$hmac" == *$'\r'* ]]; then
  echo "Bridgefu HMAC credential is invalid" >&2
  exit 1
fi

temporary="$(mktemp /run/bridgefu/runtime.env.XXXXXX)"
trap 'rm -f "$temporary"' EXIT
printf 'BRIDGEFU_API_BEARER_TOKEN=%s\nBRIDGEFU_CONTROL_HMAC_KEY=%s\n' \
  "$bearer" "$hmac" > "$temporary"
chmod 0600 "$temporary"
mv -f "$temporary" /run/bridgefu/runtime.env
trap - EXIT
unset bearer hmac
