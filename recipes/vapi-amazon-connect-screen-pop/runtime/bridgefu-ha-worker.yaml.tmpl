config_version: 1

aws:
  region: __AWS_REGION__

edge:
  public_host: __SIP_HOSTNAME__
  media_public_addr: __PUBLIC_IP__:0
__SIP_EDGE_CONFIG__

api:
  enabled: false
  bearer_token: env:BRIDGEFU_API_BEARER_TOKEN
  control_hmac_key: env:BRIDGEFU_CONTROL_HMAC_KEY

recipes:
  support:
    use: builtin:vapi-amazon-connect-screen-pop@1
    with:
      vapi_signaling_cidrs:
__VAPI_SIGNALING_CIDRS__
      connect_instance_arn: __CONNECT_INSTANCE_ARN__
      connect_entry_contact_flow_id: __CONNECT_ENTRY_FLOW_ID__
      sip_security: __SIP_SECURITY__

persistence:
  backend: postgres
  database_url: env:BRIDGEFU_DATABASE_URL
  worker_id: __WORKER_ID__
  deployment_id: __DEPLOYMENT_ID__
  worker_capabilities: [amazon_connect]
  redis_url: env:BRIDGEFU_REDIS_URL
  redis_clustered: true

broadcast:
  public_endpoint: uctp+quic://__UCTP_HOSTNAME__:4433
  token_secret: env:BRIDGEFU_BROADCAST_TOKEN_SECRET

private_forwarding:
  enabled: true
  token_signing_secret: env:BRIDGEFU_PRIVATE_FORWARDING_SECRET
  worker:
    bind: 0.0.0.0:9443
    tls:
      certificate_chain: [/etc/bridgefu/private/worker.crt]
      private_key: /etc/bridgefu/private/worker.key
      peer_ca_certificates: [/etc/bridgefu/private/ca.crt]
  limits:
    max_active_routes: __MAX_CONCURRENT_CALLS__
    max_peer_connections: 16
    max_routes_per_peer: __MAX_CONCURRENT_CALLS__
    media_queue_capacity: 32
    reliable_queue_capacity: 128
    inbound_queue_capacity: 128

observability:
  log_level: info
  log_format: json
  http_bind: 0.0.0.0:9090

runtime:
  mode: worker
  max_concurrent_calls: __MAX_CONCURRENT_CALLS__
  setup_timeout_secs: 15
  media_idle_timeout_secs: 120
  drain_timeout_secs: 120
