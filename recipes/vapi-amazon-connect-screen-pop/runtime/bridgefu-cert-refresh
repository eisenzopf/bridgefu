#!/usr/bin/env bash
set -euo pipefail
umask 077

source /etc/bridgefu/runtime.conf
work="$(mktemp -d /run/bridgefu-cert.XXXXXX)"
trap 'rm -rf "$work"' EXIT

aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$CERTIFICATE_PASSPHRASE_SECRET_ARN" \
  --query SecretString \
  --output text > "$work/passphrase"
if (( $(wc -c < "$work/passphrase") < 32 )); then
  echo "ACM export passphrase is invalid" >&2
  exit 1
fi

aws acm export-certificate \
  --region "$AWS_REGION" \
  --certificate-arn "$CERTIFICATE_ARN" \
  --passphrase "fileb://$work/passphrase" > "$work/export.json"
jq -er '.Certificate' "$work/export.json" > "$work/certificate.pem"
jq -er '.CertificateChain' "$work/export.json" > "$work/chain.pem"
jq -er '.PrivateKey' "$work/export.json" > "$work/private-encrypted.pem"
openssl pkey \
  -in "$work/private-encrypted.pem" \
  -passin "file:$work/passphrase" \
  -out "$work/private-key.pem" >/dev/null 2>&1
cat "$work/certificate.pem" "$work/chain.pem" > "$work/fullchain.pem"

openssl x509 -in "$work/certificate.pem" -noout -checkend 604800 >/dev/null
openssl x509 -in "$work/certificate.pem" -noout -checkhost "$BRIDGEFU_SIP_HOSTNAME" >/dev/null
openssl x509 -in "$work/certificate.pem" -noout -checkhost "$BRIDGEFU_CONTROL_HOSTNAME" >/dev/null
cert_key="$(openssl x509 -in "$work/certificate.pem" -pubkey -noout | openssl pkey -pubin -outform der 2>/dev/null | sha256sum | cut -d' ' -f1)"
private_key="$(openssl pkey -in "$work/private-key.pem" -pubout -outform der 2>/dev/null | sha256sum | cut -d' ' -f1)"
if [[ "$cert_key" != "$private_key" ]]; then
  echo "ACM certificate and private key do not match" >&2
  exit 1
fi

changed=true
if [[ -f /etc/bridgefu/tls/fullchain.pem && -f /etc/bridgefu/tls/private-key.pem ]] \
  && cmp -s "$work/fullchain.pem" /etc/bridgefu/tls/fullchain.pem \
  && cmp -s "$work/private-key.pem" /etc/bridgefu/tls/private-key.pem; then
  changed=false
fi

if $changed; then
  install -o root -g bridgefu -m 0640 "$work/fullchain.pem" /etc/bridgefu/tls/fullchain.pem.new
  install -o root -g bridgefu -m 0640 "$work/private-key.pem" /etc/bridgefu/tls/private-key.pem.new
  cat "$work/fullchain.pem" "$work/private-key.pem" > "$work/haproxy.pem"
  install -o root -g haproxy -m 0640 "$work/haproxy.pem" /etc/haproxy/bridgefu.pem.new
  mv -f /etc/bridgefu/tls/fullchain.pem.new /etc/bridgefu/tls/fullchain.pem
  mv -f /etc/bridgefu/tls/private-key.pem.new /etc/bridgefu/tls/private-key.pem
  mv -f /etc/haproxy/bridgefu.pem.new /etc/haproxy/bridgefu.pem
  haproxy -c -f /etc/haproxy/haproxy.cfg >/dev/null
  if systemctl is-active --quiet haproxy.service; then
    systemctl reload haproxy.service
  fi
  touch /run/bridgefu/certificate-reload-pending
  if systemctl is-active --quiet bridgefu.service; then
    /usr/local/sbin/bridgefu-cert-reload || true
  fi
fi

expiry="$(openssl x509 -in "$work/certificate.pem" -noout -enddate | cut -d= -f2-)"
days="$(( ($(date -d "$expiry" +%s) - $(date +%s)) / 86400 ))"
aws cloudwatch put-metric-data \
  --region "$AWS_REGION" \
  --namespace Bridgefu/Runtime \
  --metric-data "MetricName=CertificateDaysToExpiry,Dimensions=[{Name=deployment,Value=$BRIDGEFU_DEPLOYMENT_ID}],Value=$days,Unit=Count" \
  >/dev/null 2>&1 || true
echo "Bridgefu certificate refresh completed; changed=$changed days_to_expiry=$days"
