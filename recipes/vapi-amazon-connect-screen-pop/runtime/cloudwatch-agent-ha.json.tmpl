{
  "agent": {
    "metrics_collection_interval": 30,
    "region": "__AWS_REGION__",
    "run_as_user": "root"
  },
  "logs": {
    "metrics_collected": {
      "prometheus": {
        "cluster_name": "bridgefu-__DEPLOYMENT_ID__",
        "emf_processor": {
          "metric_namespace": "Bridgefu/Runtime",
          "metric_unit": {
            "bridgefu_process_ready": "Count",
            "bridgefu_gateway_native_active_routes": "Count",
            "bridgefu_private_forwarding_active_routes": "Count",
            "bridgefu_private_egress_active_routes": "Count",
            "bridgefu_amazon_durable_cleanups_pending": "Count"
          },
          "metric_declaration": [
            {
              "source_labels": ["job"],
              "label_matcher": "^bridgefu$",
              "dimensions": [["deployment", "role", "slot"]],
              "metric_selectors": [
                "^bridgefu_process_ready$",
                "^bridgefu_gateway_native_active_routes$",
                "^bridgefu_private_forwarding_active_routes$",
                "^bridgefu_private_egress_active_routes$",
                "^bridgefu_amazon_durable_cleanups_pending$"
              ]
            }
          ],
          "metric_declaration_dedup": true
        },
        "prometheus_config_path": "/opt/aws/amazon-cloudwatch-agent/var/bridgefu-prometheus.yaml"
      }
    },
    "force_flush_interval": 5
  },
  "metrics": {
    "namespace": "Bridgefu/Host",
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {"measurement": ["cpu_usage_idle", "cpu_usage_iowait"], "totalcpu": true},
      "disk": {"measurement": ["used_percent", "inodes_free"], "resources": ["/"]},
      "mem": {"measurement": ["mem_used_percent"]},
      "net": {"measurement": ["bytes_sent", "bytes_recv", "drop_in", "drop_out"], "resources": ["*"]}
    }
  }
}
