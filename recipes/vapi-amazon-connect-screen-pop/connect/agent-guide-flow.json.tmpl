{
  "Version": "2019-10-30",
  "StartAction": "show-context",
  "Actions": [
    {
      "Identifier": "show-context",
      "Type": "ShowView",
      "Parameters": {
        "ViewResource": {
          "Id": "detail",
          "Version": "Latest"
        },
        "InvocationTimeLimitSeconds": "3600",
        "ViewData": {
          "Heading": "Bridgefu caller context",
          "Description": "Information collected before this handoff. Confirm it with the caller when appropriate.",
          "Sections": [
            {
              "TemplateString": "<h3>Support request</h3><p><strong>Customer:</strong> $.Attributes.customer_name</p><p><strong>Issue:</strong> $.Attributes.issue_summary</p><p><strong>Intent:</strong> $.Attributes.intent</p><p><strong>Verification:</strong> $.Attributes.verification_status</p>"
            },
            {
              "TemplateString": "<p><strong>Context available:</strong> $.Attributes.context_available</p><p><strong>Voice AI call reference:</strong> $.Attributes.vapi_call_reference</p>"
            }
          ],
          "AttributeBar": [
            {
              "Label": "Customer",
              "Value": "$.Attributes.customer_name"
            },
            {
              "Label": "Intent",
              "Value": "$.Attributes.intent"
            }
          ],
          "Actions": [],
          "Back": {
            "Label": "Close"
          }
        }
      },
      "Transitions": {
        "NextAction": "end-guide",
        "Conditions": [
          {
            "NextAction": "end-guide",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["Back"]
            }
          }
        ],
        "Errors": [
          {
            "NextAction": "end-guide",
            "ErrorType": "NoMatchingCondition"
          },
          {
            "NextAction": "end-guide",
            "ErrorType": "NoMatchingError"
          },
          {
            "NextAction": "end-guide",
            "ErrorType": "TimeLimitExceeded"
          }
        ]
      }
    },
    {
      "Identifier": "end-guide",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
