{
  "Version": "2019-10-30",
  "StartAction": "lookup-context",
  "Actions": [
    {
      "Identifier": "lookup-context",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "__LOOKUP_LAMBDA_ARN__",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "correlation_id": "$.Attributes.correlation_id"
        }
      },
      "Transitions": {
        "NextAction": "copy-context",
        "Errors": [
          {
            "NextAction": "context-unavailable",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "copy-context",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "context_available": "$.External.context_available",
          "screen_pop_label_1": "$.External.screen_pop_label_1",
          "screen_pop_value_1": "$.External.screen_pop_value_1",
          "screen_pop_label_2": "$.External.screen_pop_label_2",
          "screen_pop_value_2": "$.External.screen_pop_value_2",
          "screen_pop_label_3": "$.External.screen_pop_label_3",
          "screen_pop_value_3": "$.External.screen_pop_value_3",
          "screen_pop_label_4": "$.External.screen_pop_label_4",
          "screen_pop_value_4": "$.External.screen_pop_value_4",
          "screen_pop_label_5": "$.External.screen_pop_label_5",
          "screen_pop_value_5": "$.External.screen_pop_value_5",
          "screen_pop_label_6": "$.External.screen_pop_label_6",
          "screen_pop_value_6": "$.External.screen_pop_value_6",
          "screen_pop_label_7": "$.External.screen_pop_label_7",
          "screen_pop_value_7": "$.External.screen_pop_value_7",
          "screen_pop_label_8": "$.External.screen_pop_label_8",
          "screen_pop_value_8": "$.External.screen_pop_value_8",
          "vapi_call_reference": "$.External.vapi_call_reference",
          "bridgefu_routing_value": "$.External.routing_value"
        }
      },
      "Transitions": {
        "NextAction": "set-agent-guide",
        "Errors": [
          {
            "NextAction": "context-unavailable",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "context-unavailable",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "context_available": "false",
          "screen_pop_label_1": "Context unavailable",
          "screen_pop_value_1": "Please ask the caller for a brief summary.",
          "screen_pop_label_2": "unavailable",
          "screen_pop_value_2": "unavailable",
          "screen_pop_label_3": "unavailable",
          "screen_pop_value_3": "unavailable",
          "screen_pop_label_4": "unavailable",
          "screen_pop_value_4": "unavailable",
          "screen_pop_label_5": "unavailable",
          "screen_pop_value_5": "unavailable",
          "screen_pop_label_6": "unavailable",
          "screen_pop_value_6": "unavailable",
          "screen_pop_label_7": "unavailable",
          "screen_pop_value_7": "unavailable",
          "screen_pop_label_8": "unavailable",
          "screen_pop_value_8": "unavailable",
          "vapi_call_reference": "unavailable",
          "bridgefu_routing_value": ""
        }
      },
      "Transitions": {
        "NextAction": "set-agent-guide",
        "Errors": [
          {
            "NextAction": "transfer-to-customer-flow",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "set-agent-guide",
      "Type": "UpdateContactEventHooks",
      "Parameters": {
        "EventHooks": {
          "DefaultAgentUI": "__AGENT_GUIDE_FLOW_ARN__"
        }
      },
      "Transitions": {
        "NextAction": "choose-reviewed-route",
        "Errors": [
          {
            "NextAction": "transfer-to-customer-flow",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "choose-reviewed-route",
      "Type": "Compare",
      "Parameters": {
        "ComparisonValue": "$.Attributes.bridgefu_routing_value"
      },
      "Transitions": {
        "NextAction": "transfer-to-customer-flow",
        "Conditions": [],
        "Errors": [
          {
            "NextAction": "transfer-to-customer-flow",
            "ErrorType": "NoMatchingCondition"
          }
        ]
      }
    },
    {
      "Identifier": "transfer-to-customer-flow",
      "Type": "TransferToFlow",
      "Parameters": {
        "ContactFlowId": "__TARGET_CONTACT_FLOW_ARN__"
      },
      "Transitions": {
        "NextAction": "disconnect",
        "Errors": [
          {
            "NextAction": "disconnect",
            "ErrorType": "NoMatchingError"
          }
        ]
      }
    },
    {
      "Identifier": "disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
