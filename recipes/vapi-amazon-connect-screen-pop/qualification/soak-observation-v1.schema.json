{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgefu.dev/recipes/vapi-amazon-connect-screen-pop/qualification/soak-observation-v1.schema.json",
  "title": "Bridgefu protected one-hour soak observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "producer_revision_sha256", "execution_id", "recipe", "started_at", "ended_at", "minutes", "revisions", "attempted_calls", "completed_calls", "unexpected_failures", "call_evidence_sha256", "setup_latency_ms_p95", "audio_latency_ms_p95", "telemetry", "zero_state", "passed", "redacted", "customer_data_retained"],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {"const": "bridgefu-qualification-controller@1"},
    "producer_revision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "pattern": "^bft-[a-z0-9-]{4,20}$"},
    "recipe": {"const": "vapi-amazon-connect-screen-pop@1"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "minutes": {"type": "integer", "minimum": 60, "maximum": 1440},
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "source_tree_sha256", "image"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image": {"type": "string", "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"}
      }
    },
    "attempted_calls": {"type": "integer", "minimum": 1, "maximum": 256},
    "completed_calls": {"type": "integer", "minimum": 1, "maximum": 256},
    "unexpected_failures": {"const": 0},
    "call_evidence_sha256": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "setup_latency_ms_p95": {"type": "number", "minimum": 0, "maximum": 30000},
    "audio_latency_ms_p95": {"type": "number", "minimum": 0, "maximum": 5000},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_percent_max", "memory_percent_max", "file_descriptors_max", "rtp_ports_in_use_max", "network_errors", "media_drops", "lambda_errors", "dynamodb_errors", "cleanup_backlog_max"],
      "properties": {
        "cpu_percent_max": {"type": "number", "minimum": 0, "maximum": 100},
        "memory_percent_max": {"type": "number", "minimum": 0, "maximum": 100},
        "file_descriptors_max": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "rtp_ports_in_use_max": {"type": "integer", "minimum": 1, "maximum": 16384},
        "network_errors": {"const": 0},
        "media_drops": {"const": 0},
        "lambda_errors": {"const": 0},
        "dynamodb_errors": {"const": 0},
        "cleanup_backlog_max": {"const": 0}
      }
    },
    "zero_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_calls", "active_contacts", "active_routes", "cleanup_backlog"],
      "properties": {
        "active_calls": {"const": 0},
        "active_contacts": {"const": 0},
        "active_routes": {"const": 0},
        "cleanup_backlog": {"const": 0}
      }
    },
    "passed": {"const": true},
    "redacted": {"const": true},
    "customer_data_retained": {"const": false}
  }
}
