# Rust
/target
/tests/moq-browser-e2e/node_modules
/tests/moq-browser-e2e/dist
node_modules/

# Python validation/runtime-smoke bytecode
__pycache__/
*.py[cod]
/.pytest_cache/
/.ruff_cache/
/.venv/

# Local coverage output
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/

# Local agent/editor and operating-system metadata
/.claude/worktrees/
/tmp/
/.tmp/
*.tmp
.DS_Store

# Logs
*.log

# Local runtime credentials and TLS material. Compose mounts deploy/tls at
# runtime; none of these files belongs in source control.
/deploy/tls/
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks

# Operator's filled-in config (contains your instance/flow IDs). Commit only
# config/bridgefu.example.yaml, not the real one.
/bridgefu.yaml

# There is no Terraform in this repository any more; deployment lives in
# eisenzopf/bridgefu-vapi-awsconnect. These stay as a guard so a local
# experiment can never commit state or real variable values.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
.vscode
crash.*.log

# Output from the repository README's recipe-init walkthrough. It contains
# operator-filled deployment values and must never become repository source.
/bridgefu-vapi-connect/

# NOTE: Cargo.lock IS committed — bridgefu is a binary and we want reproducible
# builds. deploy/Dockerfile relies on it for the MSRV-pinned tree, and
# bridgefu-vapi-awsconnect SHA-256s its bytes as an AMI build input.

# Stale local caches from the pre-split layout. The Lambda, Terraform, and
# qualification sources for vapi-amazon-connect-screen-pop now live in
# eisenzopf/bridgefu-vapi-awsconnect. Only recipe.yaml and values.example.yaml
# belong here — both are include_str!'d into the binary.
/recipes/*/lambda/
/recipes/*/runtime/
/recipes/*/tests/
/recipes/*/terraform/
